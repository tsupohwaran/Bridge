\begin_body

\begin_layout Section*
1.
 Model Setup
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
L_{j}=\sum_{z}\frac{\left(w_{j}d_{zj}^{-\eta}\right)^{\theta}l_{z}}{\sum_{j\prime}\left(w_{j\prime}d_{zj\prime}^{-\eta}\right)^{\theta}}=\sum_{z}\pi_{zj}l_{z}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\varepsilon_{j}=\sum_{z\in Z}\gamma_{zj}\varepsilon_{zj}=\sum_{z\in Z}\gamma_{zj}\theta\left(1-\pi_{zj}\right)
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
w_{j} & =P_{j}\alpha z_{j}l_{j}^{\alpha-1}\times\frac{\varepsilon_{j}}{1+\varepsilon_{j}}
\end{align*}

\end_inset


\end_layout

\begin_layout Section*
2.
 Labor Reallocation
\end_layout

\begin_layout Standard
不妨定义：

\begin_inset Formula $MA_{j}=\sum_{z}\frac{\left(d_{zj}^{-\eta}\right)^{\theta}l_{z}}{\sum_{j\prime}\left(d_{zj\prime}^{-\eta}\right)^{\theta}}$
\end_inset

，
其中皆为外生参数。
则：

\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
L_{j} & =w_{j}\sum_{z}\frac{\left(d_{zj}^{-\eta}\right)^{\theta}l_{z}}{\sum_{j\prime}\left(w_{j\prime}d_{zj\prime}^{-\eta}\right)^{\theta}}\\
d\ln L_{j} & \approx\varepsilon_{j}d\ln w_{j}+\beta d\ln MA_{j}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
根据企业生产函数可知：

\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\ln w_{j} & =\ln\left(P_{j}\alpha z_{j}\right)+\left(\alpha-1\right)\ln L_{j}+\ln\mu_{j}\approx\left(\alpha-1\right)\ln L_{j}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
d\ln L_{j}=\frac{\beta}{1+\varepsilon_{j}\left(1-\alpha\right)}d\ln MA_{j}=\beta\left(w_{j}\right)\times d\ln MA_{j}
\]

\end_inset


\end_layout

\begin_layout Standard
其中，

\begin_inset Formula $\beta\left(w_{j}\right)$
\end_inset

反应了
\begin_inset Formula $MA_{j}$
\end_inset

对不同工资企业的异质性影响。
高工资企业平均而言具有更高的市场份额，
即
\begin_inset Formula $\varepsilon_{j}=\sum_{z\in Z}\gamma_{zj}\theta\left(1-\pi_{zj}\right)\approx\theta\left(1-\bar{\pi}_{j}\right)$
\end_inset

。
因此
\begin_inset Formula $\varepsilon_{j}^{-1}\propto w_{j}\propto\beta\left(w_{j}\right)$
\end_inset

。

\end_layout

\begin_layout Standard
不妨假设：

\begin_inset Formula $\beta\left(w_{j}\right)\approx\beta_{1}+\beta_{2}\ln w_{j}$
\end_inset

，
则：

\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
d\ln L_{j}\approx\underbrace{\frac{\beta}{1+\varepsilon_{j}\left(1-\alpha\right)}}_{\beta_{1}}d\ln MA_{j}+\beta_{2}\left(d\ln MA_{j}\times\ln w_{j}\right)
\]

\end_inset


\end_layout

