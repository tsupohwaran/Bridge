\uuline default
\uwave default
\noun default
\color inherit
=1）平均值。
为什么不用全部企业的平均值？

\end_layout

\begin_layout Standard
因为（1）交互项回归系数的含义是，
工资不同如何影响处理组相较于控制组的
\begin_inset Formula $d\ln l_{j}$
\end_inset

的差距？
如果全局均值偏低，
处理组工资偏高，
这会导致处理组中甚至没有工资等于全局均值的样本，
OLS需要外推以估计系数。

\end_layout

\begin_layout Standard
（2）让
\begin_inset Formula $\text{BigMA}$
\end_inset

与
\begin_inset Formula $(\ln w_{j}-\overline{\ln w_{j}})$
\end_inset

正交
\end_layout

\begin_layout Standard
如果模型中的
\begin_inset Formula $\ln w_{j}$
\end_inset

方差与数据中差距较大，
可以考虑再除以方差。

\end_layout

\begin_layout Standard
Step3:
 如果N组回归系数的均值
\begin_inset Formula $\bar{\beta_{1}},\bar{\beta_{2}}$
\end_inset

与实际数据中估计得到的相近，
则得到合理的
\begin_inset Formula $\theta$
\end_inset

和
\begin_inset Formula $\eta$
\end_inset

。
即：

\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\left(\hat{\theta},\hat{\eta}\right)=\arg\min_{\tilde{\theta},\tilde{\eta}}\left(m^{model}\left(\theta,\eta\right)-m^{data}\right)^{\top}W\left(m^{model}\left(\theta,\eta\right)-m^{data}\right)
\]

\end_inset


\end_layout

\begin_layout Standard
其中，

\begin_inset Formula $m^{data}=\left(\begin{array}{c}
\beta^{data}_{1}\\
\beta^{data}_{2}
\end{array}\right)$
\end_inset

，

\begin_inset Formula $m^{model}\left(\theta,\eta\right)=\left(\begin{array}{c}
\bar{\beta_{1}}\left(\theta,\eta\right)\\
\bar{\beta_{2}}\left(\theta,\eta\right)
\end{array}\right)$
\end_inset

。

\begin_inset Formula $W$
\end_inset

可以直接用
\begin_inset Formula $I$
\end_inset

，
也可以用
\begin_inset Formula $\Sigma$
\end_inset

（
\begin_inset Formula $m^{data}$
\end_inset

的协方差矩阵）
\end_layout

\begin_layout Subsection*
5.2 
\begin_inset Formula $\alpha_{j}$
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
w_{j} & =P_{j}\frac{\partial Y_{j}\left(l_{j}\right)}{\partial l_{j}}\times\frac{\varepsilon_{j}}{1+\varepsilon_{j}}\\
 & =P_{j}\alpha z_{j}l^{\alpha-1}_{j}\times\frac{\varepsilon_{j}}{1+\varepsilon_{j}}=\alpha_{j}R_{j}l^{-1}_{j}\times\frac{\varepsilon_{j}}{1+\varepsilon_{j}}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
normalize\ P_{j}\ to\ 1\Rightarrow\alpha_{j}=\frac{w_{j}}{z_{j}l^{\alpha_{j}-1}_{j}}\times\frac{1+\varepsilon_{j}}{\varepsilon_{j}}
\]

\end_inset


\end_layout

\begin_layout Subsection*
5.3 模型求解
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
guess\quad w_{j}\begin{cases}
\pi_{zj}=\frac{\left(w_{j}d^{-\eta}_{zj}\right)^{\theta}}{\sum_{j\prime}\left(w_{j\prime}d^{-\eta}_{zj\prime}\right)^{\theta}}\\
\varepsilon_{zj}=\theta\left[1-\pi_{zj}\right]\\
\varepsilon_{j}=\sum_{z}\frac{\pi_{zj}l_{z}}{\sum_{z\prime}\pi_{z\prime j}l_{z\prime}}\varepsilon_{zj}\\
\triangle:\frac{\alpha z_{j}l^{\alpha-1}_{j}}{w_{j}}=1+\varepsilon^{-1}_{j}
\end{cases}
\]

\end_inset


\end_layout

