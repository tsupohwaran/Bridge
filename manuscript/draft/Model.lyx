\begin_layout Section*
1.
 Worker
\end_layout

\begin_layout Subsection*
1.1 偏好
\end_layout

\begin_layout Standard
选择企业
\begin_inset Formula $j$
\end_inset

工作、
\begin_inset Formula $z$
\end_inset

地居住（不移动）的员工
\begin_inset Formula $i$
\end_inset

的间接效用为：

\begin_inset Formula 
\[
U_{izj}=\ln w_{j}-\eta_{j}\ln d_{zj}+\frac{1}{\theta}\epsilon_{ij}
\]

\end_inset


\end_layout

\begin_layout Standard
其中，

\begin_inset Formula $w_{j}$
\end_inset

为工资，
员工与企业的通勤时间为
\begin_inset Formula $d_{zj}$
\end_inset

；

\begin_inset Formula $\eta$
\end_inset

为“工资-通勤弹性”，
反映了员工愿意以1%的通勤时间换%多少的工资；

\begin_inset Formula $\epsilon_{ij}$
\end_inset

为偏好冲击，
服从多元Gumbel分布：

\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
F\text{(\epsilon_{i1},\epsilon_{i2},...,\epsilon_{ij})=exp\left\{  -\sum_{s\in S}\left\{  \sum_{j\in J(s)}e^{-\frac{\epsilon_{ij}}{\sigma}}\right\}  ^{\sigma}\right\}  }
\]

\end_inset


\end_layout

\begin_layout Standard
其中，

\begin_inset Formula $s$
\end_inset

为街道（乡镇）；

\begin_inset Formula $\sigma$
\end_inset

为同一街道企业之间偏好冲击的相关性。

\end_layout

\begin_layout Standard

\series bold
性质1：

\series default

\begin_inset Formula $\sigma\approx\sqrt{1-Corr\left(\epsilon_{ij},\epsilon_{ij\prime}\right)}$
\end_inset

。
当
\begin_inset Formula $\sigma\rightarrow0$
\end_inset

时，
 企业间完全替代；
当
\begin_inset Formula $\sigma\rightarrow1$
\end_inset

时，
等价于idiosyncratic shock
\end_layout

\begin_layout Standard

\series bold
性质2：

\series default
Nested Logit等价于Nested CES，
街道之间的替代弹性
\begin_inset Formula $\eta\prime=\frac{\theta}{\sigma}-1$
\end_inset

，
企业间替代弹性
\begin_inset Formula $\theta\prime=\theta-1$
\end_inset


\end_layout

\begin_layout Subsection*
1.2 劳动力供给
\end_layout

\begin_layout Standard
员工选择使自身效用最大化的企业
\begin_inset Formula $j$
\end_inset

工作，
结合性质，
可以得到
\begin_inset Formula $z$
\end_inset

地区去企业
\begin_inset Formula $j\in J(s)$
\end_inset

工作的工人比例
\begin_inset Formula $\pi_{zj}$
\end_inset

为：

\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\pi_{zj}=\pi_{zs}\underbrace{\frac{\left(w_{j}d^{-\eta}_{zj}\right)^{\frac{\theta}{\sigma}}}{\sum_{j\prime\in J(s)}\left(w_{j\prime}d^{-\eta}_{zj\prime}\right)^{\frac{\theta}{\sigma}}}}_{\pi_{zj\mid s}}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\pi_{zs}=\frac{\left\{ \sum_{j\prime\in J(s)}\left(w_{j\prime}d^{-\eta}_{zj\prime}\right)^{\frac{\theta}{\sigma}}\right\} ^{\sigma}}{\sum_{s\prime}\left\{ \sum_{j\in J(s\prime)}\left(w_{j\prime}d^{-\eta}_{zj\prime}\right)^{\frac{\theta}{\sigma}}\right\} ^{\sigma}}
\]

\end_inset

 
\end_layout

\begin_layout Standard
其中，

\begin_inset Formula $\pi_{zs}$
\end_inset

表示
\begin_inset Formula $z$
\end_inset

地区工人去街道
\begin_inset Formula $s$
\end_inset

工作的比例；

\begin_inset Formula $\pi_{zj\mid s}$
\end_inset

表示给定工人去街道
\begin_inset Formula $s$
\end_inset

，
居住在
\begin_inset Formula $z$
\end_inset

地区的工人去企业
\begin_inset Formula $j\in J(s)$
\end_inset

工作的比例。

\end_layout

\begin_layout Standard
因此，
居住在地区
\begin_inset Formula $z$
\end_inset

且去企业
\begin_inset Formula $j$
\end_inset

的工人的劳动力供给弹性
\begin_inset Formula $\varepsilon_{zj}$
\end_inset

为：

\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\varepsilon_{zj}:=\frac{\partial\ln\pi_{zj}}{\partial\ln w_{j}}=\theta\left[\frac{1}{\sigma}+\left(1-\frac{1}{\sigma}\right)\pi_{zj\mid s}-\pi_{zj}\right]
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\pi_{zj}\in\text{(0,1)}
\]

\end_inset


\end_layout

\begin_layout Standard

\series bold
推论1：

\series default
当
\begin_inset Formula $\sigma\rightarrow1$
\end_inset

时，
有
\begin_inset Formula $\varepsilon_{zj}\rightarrow\theta\left(1-\pi_{zj}\right)$
\end_inset

。
即，
如果企业
\begin_inset Formula $j$
\end_inset

在劳动力市场
\begin_inset Formula $z$
\end_inset

的份额高，
那么面临该劳动力市场
\begin_inset Formula $z$
\end_inset

的弹性小。

\end_layout

\begin_layout Standard

\series bold
推论2
\series default
：

\begin_inset Formula $\forall z,\varepsilon_{zj}<\varepsilon_{zj\prime},if\ prod_{j}>prod_{j\prime}$
\end_inset


\end_layout

\begin_layout Standard

\series bold
推论3：

\series default
当
\begin_inset Formula $\theta\rightarrow\infty$
\end_inset

时（
\begin_inset Formula $\epsilon_{ij}$
\end_inset

离散程度极小），
工人对企业的偏好几乎不再有随机性，
几乎只会确定性地选择最优的某个企业供给劳动力，

\begin_inset Formula $\varepsilon_{zj}\rightarrow\infty$
\end_inset

。

\end_layout

\begin_layout Standard

\series bold
推论4（经济学含义同Berger）：

\series default

\begin_inset Formula $d_{zj}\propto\varepsilon_{zj}$
\end_inset

。

\end_layout

\begin_layout Section*
2.
 Firm
\end_layout

\begin_layout Standard
企业位置外生给定，
不同企业的产品在市场上完全替代（产品价格标准化为1），
在劳动力市场具有垄断力量，
但只能观测到平均劳动力供给弹性（不能对来自不同地方的工人实行工资歧视），
需要选择最优的工资以实现成本最小化：

\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\begin{array}{c}
\min_{w_{j}}w_{j}l_{j}\\
s.t.\quad Y_{j}\left(l_{j}\right)=z_{j}l^{\alpha}_{j}\geq Q_{j}\\
w_{j}\geq0\\
0<\alpha\leq1
\end{array}
\]

\end_inset


\end_layout

\begin_layout Standard
可以推导出，
企业面临的平均劳动力供给弹性为个人劳动力供给弹性
\begin_inset Formula $\varepsilon_{zj}$
\end_inset

的加权平均：

\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\varepsilon_{j}=\sum_{z\in Z}\gamma_{zj}\varepsilon_{zj}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\frac{MPL_{j}}{w_{j}}=1+\varepsilon^{-1}_{j}
\]

\end_inset


\end_layout

\begin_layout Standard
其中，

\begin_inset Formula $\gamma_{zj}:=\frac{\pi_{zj}l_{z}}{\sum_{z\prime}\pi_{z\prime j}l_{z\prime}}$
\end_inset

表示
\begin_inset Formula $z$
\end_inset

地区员工占企业
\begin_inset Formula $j$
\end_inset

总员工数量的比例。

\end_layout

\begin_layout Standard

\series bold
推论1：

\series default
如果企业的员工大部分都来自较远的地区（
\begin_inset Formula $\gamma_{zj}$
\end_inset

大），

\begin_inset Formula $\varepsilon_{zj}=\theta\left(1-\pi_{zj}\right)$
\end_inset

则劳动力供给弹性
\begin_inset Formula $\varepsilon_{j}$
\end_inset

大，
劳动力市场垄断力量小（markdown小）。

\end_layout

\begin_layout Standard

\series bold
\color red
推论
\color inherit
2：

\series default
如果
\begin_inset Formula $d_{zj}=d_{zj\prime},\forall z$
\end_inset

，
则
\begin_inset Formula $\gamma_{zj\prime}=\gamma_{zj},\forall z$
\end_inset

；
不依赖nest
\end_layout

\begin_layout Standard

\series bold
推论3
\series default
：
如果
\begin_inset Formula $\forall z,j,\frac{\Delta d_{zj}}{d_{zj}}=constant$
\end_inset

，
则
\begin_inset Formula $\Delta\varepsilon_{j}=0,\forall j$
\end_inset


\end_layout

\begin_layout Standard

\series bold
推论4：

\series default

\begin_inset Formula 
\begin{align*}
\frac{\partial\varepsilon_{j}}{\partial d_{zj\prime}} & =\frac{\partial\pi_{zj}}{\partial d_{zj\prime}}\gamma_{zj}\left(\frac{\varepsilon_{zj}-\varepsilon_{j}}{\pi_{zj}}-\theta\right)\\
 & =\frac{\eta\theta}{d_{zj\prime}}\gamma_{zj}\left(\mathbf{1}_{j=j\prime}-\pi_{zj\prime}\right)\left(\varepsilon_{j}-\varepsilon_{zj}+\theta\pi_{zj}\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\frac{\partial\pi_{zj}}{\partial d_{zj\prime}}=-\frac{\eta\theta}{d_{zj\prime}}\pi_{zj}\left(\mathbf{1}_{j=j\prime}-\pi_{zj\prime}\right)
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\frac{\partial^{2}\ln\pi_{zj}}{\partial\ln d_{zj\prime}\partial\ln w_{j}}=\frac{\partial\varepsilon_{zj}}{\partial\ln d_{zj\prime}}=\frac{\partial\theta(1-\pi_{zj})}{\partial\ln d_{zj\prime}}=-\theta\frac{\partial\pi_{zj}}{\partial\ln d_{zj\prime}}=\theta d_{zj\prime}\frac{\partial\pi_{zj}}{\partial d_{zj\prime}}=\eta\theta^{2}\pi_{zj}\left(\mathbf{1}_{j=j\prime}-\pi_{zj\prime}\right)
\]

\end_inset


\end_layout

\begin_layout Standard
即，
同样的
\begin_inset Formula $d_{zj}$
\end_inset

冲击，

\begin_inset Formula $w_{j}$
\end_inset

高的企业
\begin_inset Formula $\pi_{zj}$
\end_inset

上升更多。

\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
L_{j}=\sum_{z}\frac{\left(w_{j}d^{-\eta}_{zj}\right)^{\theta}l_{z}}{\sum_{j\prime}\left(w_{j\prime}d^{-\eta}_{zj\prime}\right)^{\theta}}=\sum_{z}\pi_{zj}l_{z}
\]

\end_inset


\end_layout

