\begin_layout Section*
5.
 Calibration
\end_layout

\begin_layout Subsection*
5.1 
\begin_inset Formula $\theta,\eta$
\end_inset


\end_layout

\begin_layout Standard
Step1：
Given一组
\begin_inset Formula $\left(\theta,\eta\right)$
\end_inset

，
青岛市制造业企业信息（工企库+税调库）
\end_layout

\begin_layout Standard
Step2：
求解MA变化前后的均衡，
并进行如下回归，
估计得到
\begin_inset Formula $\beta_{1}$
\end_inset

和
\begin_inset Formula $\beta_{2}$
\end_inset

：

\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
MA_{j}=\sum_{z}\frac{l_{z}}{l}d_{zj}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
d\ln l_{j}=\beta_{0}+\beta_{1}\text{BigMA}+\beta_{2}\Big(\text{BigMA}\times(\ln w_{j}-\overline{\ln w_{j}})\Big)
\]

\end_inset


\end_layout

\begin_layout Standard
其中，

\begin_inset Formula $\overline{\ln w_{j}}$
\end_inset

为初始工资的处理组（
\family roman
\series medium
\shape up
\size normal
\emph off
\nospellcheck off
\bar no
