\begin_layout Section*
1.
 Worker
\end_layout

\begin_layout Subsection*
1.1 偏好
\end_layout

\begin_layout Standard
选择企业
\begin_inset Formula $j$
\end_inset

工作、
\begin_inset Formula $z$
\end_inset

地居住（不移动）的员工
\begin_inset Formula $i$
\end_inset

的间接效用为：

\begin_inset Formula 
\[
U_{izj}=\ln w_{j}-\eta\ln d_{zj}+\frac{1}{\theta}\epsilon_{ij}
\]

\end_inset


\end_layout

\begin_layout Standard
其中，

\begin_inset Formula $w_{j}$
\end_inset

为工资，
员工与企业的通勤时间为
\begin_inset Formula $d_{zj}$
\end_inset

；

\begin_inset Formula $\eta$
\end_inset

为“工资-通勤弹性”，
反映了员工愿意以1%的通勤时间换%多少的工资；

\begin_inset Formula $\epsilon_{ij}$
\end_inset

为偏好冲击，
服从多元分布：

\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
F\text{(\epsilon_{i1},\epsilon_{i2},...,\epsilon_{ij})=exp\left\{  -\sum_{s\in S}\left\{  \sum_{j\in J(s)}e^{-\frac{\epsilon_{ij}}{\sigma}}\right\}  ^{\sigma}\right\}  }
\]

\end_inset


\end_layout

\begin_layout Standard
其中，

\begin_inset Formula $s$
\end_inset

为街道（乡镇）；

\begin_inset Formula $\sigma$
\end_inset

为同一街道企业之间偏好冲击的相关性。
当
\begin_inset Formula $\sigma\rightarrow0$
\end_inset

时，
 企业间完全替代；
当
\begin_inset Formula $\sigma\rightarrow1$
\end_inset

时，
企业间完全独立。

\end_layout

\begin_layout Subsection*
1.2 劳动力供给
\end_layout

\begin_layout Standard
员工选择使自身效用最大化的企业
\begin_inset Formula $j$
\end_inset

工作，
结合性质，
可以得到
\begin_inset Formula $z$
\end_inset

地区去企业
\begin_inset Formula $j\in J(s)$
\end_inset

工作的工人比例
\begin_inset Formula $\pi_{zj}$
\end_inset

为：

\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\pi_{zj}=\pi_{zs}\underbrace{\frac{\exp\left(\frac{\ln\left(w_{j}d_{zj}^{-\eta}\right)^{\theta}}{\sigma}\right)}{\sum_{j\prime\in J(s)}\exp\left(\frac{\ln\left(w_{j\prime}d_{zj\prime}^{-\eta}\right)^{\theta}}{\sigma}\right)}}_{\pi_{zj\mid s}}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\pi_{zs}=\frac{\left\{ \sum_{j\prime\in J(s)}\exp\left(\frac{\ln\left(w_{j\prime}d_{zj\prime}^{-\eta}\right)^{\theta}}{\sigma}\right)\right\} ^{\sigma}}{\sum_{s\prime}\left\{ \sum_{j\in J(s\prime)}\exp\left(\frac{\ln\left(w_{j}d_{zj}^{-\eta}\right)^{\theta}}{\sigma}\right)\right\} ^{\sigma}}
\]

\end_inset

 
\end_layout

\begin_layout Standard
其中，

\begin_inset Formula $\pi_{zs}$
\end_inset

表示
\begin_inset Formula $z$
\end_inset

地区工人去街道
\begin_inset Formula $s$
\end_inset

工作的比例；

\begin_inset Formula $\pi_{zj\mid s}$
\end_inset

表示给定工人去街道
\begin_inset Formula $s$
\end_inset

，
居住在
\begin_inset Formula $z$
\end_inset

地区的工人去企业
\begin_inset Formula $j\in J(s)$
\end_inset

工作的比例。

\end_layout

\begin_layout Standard
因此，
居住在地区
\begin_inset Formula $z$
\end_inset

且去企业
\begin_inset Formula $j$
\end_inset

的工人的劳动力供给弹性
\begin_inset Formula $\varepsilon_{zj}$
\end_inset

为：

\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\varepsilon_{zj}:=\frac{\partial\ln\pi_{zj}}{\partial\ln w_{j}}=\theta\left[\frac{1}{\sigma}+\left(1-\frac{1}{\sigma}\right)\pi_{zj\mid s}-\pi_{zj}\right]
\]

\end_inset


\end_layout

\begin_layout Standard
当
\begin_inset Formula $\sigma\rightarrow1$
\end_inset

时，
有
\begin_inset Formula $\varepsilon_{zj}\rightarrow\theta\left(1-\pi_{zj}\right)$
\end_inset

。
（1）当
\begin_inset Formula $\theta\rightarrow\infty$
\end_inset

时（
\begin_inset Formula $\epsilon_{ij}$
\end_inset

离散程度极小），
工人对企业的偏好几乎不再有随机性，
几乎只会确定性地选择最优的某个企业供给劳动力，

\begin_inset Formula $\varepsilon_{zj}\rightarrow\infty$
\end_inset

。
（2）
\begin_inset Formula $d_{zj}\propto\varepsilon_{zj}$
\end_inset

。
工人距离企业越远，
需要的工资性补偿越多，
对工资的变化也越敏感。

\end_layout

\begin_layout Subsection*
1.3 Derivation of 
\begin_inset Formula $\pi_{zj}$
\end_inset

(ARRY)
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
%u_{ij}=\lnw_{j}-\eta\lnd_{zj}+\frac{1}{\theta}\epsilon_{ij}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
F\text{(\epsilon_{i1},\epsilon_{i2},...,\epsilon_{ij})=exp\left\{  -\sum_{s\in S}\left\{  \sum_{j\in J(s)}e^{-\frac{\epsilon_{ij}}{\sigma}}\right\}  ^{\sigma}\right\}  }
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
Pr\left\{ U_{iz1}\leq u_{iz1},...,U_{izj}\leq u_{izj}\right\}  & =Pr\left\{ \epsilon_{i1}\leq\theta\left(u_{iz1}-v_{z1}\right),...,\epsilon_{ij}\leq\theta\left(u_{izj}-v_{zj}\right)\right\} \\
 & =exp\left\{ -\sum_{s\in S}\left\{ \sum_{j\in J(s)}e^{-\frac{\theta\left(u_{izj}-v_{zj}\right)}{\sigma}}\right\} ^{\sigma}\right\} 
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
Pr\left\{ \epsilon_{i1}\leq\theta\left(u_{iz1}-v_{z1}\right),...,\epsilon_{ij}=\theta\left(u_{izj}-v_{zj}\right),.....\right\}  & =\frac{Pr\left\{ \epsilon_{i1}\leq\theta\left(u_{iz1}-v_{z1}\right),...,\epsilon_{ij}\leq\theta\left(u_{izj}-v_{zj}\right)\right\} }{\partial\left[\theta\left(u_{izj}-v_{zj}\right)\right]}\\
 & =exp\left\{ -\sum_{s\in S}\left\{ \sum_{j\in J(s)}e^{-\frac{\theta\left(u_{izj}-v_{zj}\right)}{\sigma}}\right\} ^{\sigma}\right\} \left(\sum_{j\in J(s)}e^{-\frac{\theta\left(u_{izj}-v_{zj}\right)}{\sigma}}\right)^{\sigma-1}e^{-\frac{\theta\left(u_{izj}-v_{zj}\right)}{\sigma}}\times\sigma\times\left(-\frac{1}{\sigma}\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
Pr\left\{ \epsilon_{i1}=\theta\left(u_{iz1}-v_{z1}\right),...,\epsilon_{ij}=\theta\left(u_{izj}-v_{zj}\right),.....\right\} =exp\left\{ -\sum_{s\in S}I_{zs}\right\} e^{-\theta u}I_{zs}^{\sigma}\pi_{zj\mid s}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
Pr\left(\text{argmax}_{j}u_{zj}=j\cap max_{j}u_{zsj}\geq u^{*}\right) & =\int_{u}^{\infty}exp\left\{ -\sum_{s\in S}I_{zs}\right\} e^{-\theta u}I_{zs}^{\sigma}\pi_{zj\mid s}du\\
 & =\pi_{zs}\pi_{zj\mid s}\frac{1-e^{\frac{1}{\theta}\ln\left(\frac{x}{\sum_{s}I_{zs}^{\sigma}}\right)}}{\theta}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
Pr\left(max_{j}u_{zj}\geq u^{*}\right)=\sum_{j}\pi_{zs}\pi_{zj\mid s}\frac{1-e^{\frac{1}{\theta}\ln\left(\frac{x}{\sum_{s}I_{zs}^{\sigma}}\right)}}{\theta}=\sum_{j}\pi_{zs}\frac{1-e^{\frac{1}{\theta}\ln\left(\frac{x}{\sum_{s}I_{zs}^{\sigma}}\right)}}{\theta}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\Rightarrow Pr\left(\text{argmax}_{j}u_{zj}=j\mid max_{j}u_{zsj}\geq u^{*}\right)=\pi_{zj\mid s}
\]

\end_inset


\end_layout

\begin_layout Standard
note that 
\begin_inset Formula $P\left(A\mid B\right)=\frac{P\left(AB\right)}{P\left(B\right)}$
\end_inset


\end_layout

\begin_layout Subsection*
1.4 Derivation of 
\begin_inset Formula $\pi_{zj}$
\end_inset

(GEV theorem)
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
F\left(\epsilon_{i1},\epsilon_{i2},...,\epsilon_{ij}\right) & =exp\left[-G\left(e^{-\varepsilon_{1}},...,e^{-\varepsilon_{j}}\right)\right]\\
G\left(z_{1},....,z_{j}\right) & =\sum_{h}\left(\sum_{j\in h}z_{j}^{\frac{1}{\sigma}}\right)^{\sigma}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
u_{ij} & =v_{ij}+\varepsilon_{ij}\\
Pr\left(i\text{去}j\right) & =\frac{e^{\frac{v_{ij}}{\sigma}\left\{ \sum_{j\in J\left(s\right)}e^{\frac{v_{ij}}{\sigma}}\right\} ^{\sigma-1}}}{\sum_{s\in S}\left\{ \sum_{j\in J\left(s\right)}e^{\frac{v_{ij}}{\sigma}}\right\} ^{\sigma}}=\pi_{zs}\pi_{zj\mid s}
\end{align*}

\end_inset


\end_layout

\begin_layout Subsection*
1.5 Derivation of 
\begin_inset Formula $\pi_{zj}$
\end_inset

(properity of multivariate distribution)
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
Pr\left(u_{ij\prime}\leq u_{ij},\forall j\prime\right) & =Pr\left(\varepsilon_{ij\prime}\leq\theta\left(v_{zj}-v_{zj\prime}\right)+\varepsilon_{ij},\forall j\prime\right)\\
 & =\int_{0}^{+\infty}F_{j}\left(\theta\left(v_{zj}-v_{z1}\right)+\varepsilon,...,\varepsilon\right)d\varepsilon
\end{align*}

\end_inset


\end_layout

\begin_layout Section*
2.
 Firm
\end_layout

\begin_layout Standard
企业位置外生给定，
不同企业的产品在市场上完全替代（产品价格标准化为1），
在劳动力市场具有垄断力量，
但只能观测到平均劳动力供给弹性（不能对来自不同地方的工人实行工资歧视），
需要选择最优的工资以实现成本最小化：

\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\begin{array}{c}
\min_{w_{j}}w_{j}l_{j}\\
s.t.\quad Y_{j}\left(l_{j}\right)=z_{j}l_{j}^{\alpha}\geq Q_{j}\\
w_{j}\geq0\\
0<\alpha\leq1
\end{array}
\]

\end_inset


\end_layout

\begin_layout Standard
可以推导出，
企业面临的平均劳动力供给弹性为个人劳动力供给弹性
\begin_inset Formula $\varepsilon_{zj}$
\end_inset

的加权平均：

\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\varepsilon_{j}=\sum_{z\in Z}\gamma_{zj}\varepsilon_{zj}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\frac{MPL_{j}}{w_{j}}=1+\varepsilon_{j}^{-1}
\]

\end_inset


\end_layout

\begin_layout Standard
其中，

\begin_inset Formula $\gamma_{zj}:=\frac{\pi_{zj}l_{z}}{\sum_{z\prime}\pi_{z\prime j}l_{z\prime}}$
\end_inset

表示
\begin_inset Formula $z$
\end_inset

地区员工占企业
\begin_inset Formula $j$
\end_inset

总员工数量的比例。
（1）如果企业的员工大部分都来自较远的地区，
则劳动力供给弹性
\begin_inset Formula $\varepsilon_{j}$
\end_inset

大，
劳动力市场垄断力量小（markdown小）。
（2）总而言之，
企业的markdown取决于员工的“Immigration vs.
 Emigration”。
如果员工来企业很容易（进容易），
但去别的企业难（出去难），
则企业的垄断力量大，
如偏远的乡镇企业。

\end_layout

